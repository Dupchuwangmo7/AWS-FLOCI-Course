{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteOwnBuildLogsOnly",
      "Effect": "Allow",
      "Action": ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": [
        "arn:aws:logs:us-east-1:000000000000:log-group:/aws/codebuild/usms-enrolment-build",
        "arn:aws:logs:us-east-1:000000000000:log-group:/aws/codebuild/usms-enrolment-build:*"
      ]
    },
    {
      "Sid": "ArtifactBucketLevel",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:GetBucketVersioning", "s3:ListBucket"],
      "Resource": "arn:aws:s3:::usms-pipeline-artifacts"
    },
    {
      "Sid": "ArtifactObjectLevel",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion", "s3:PutObject"],
      "Resource": "arn:aws:s3:::usms-pipeline-artifacts/*"
    }
  ]
}
