# Lab 10 - Lambda@Edge, CloudFront, S3-triggered notifier. Names, ARNs, IDs only. No secrets.
export USMS_BUCKET_NAME=usms-student-data
export USMS_BUCKET_ARN=arn:aws:s3:::usms-student-data
export USMS_TRANSCRIPT_PREFIX=transcripts/
export USMS_ROLE_LAMBDA=usms-lambda-exec-role
export USMS_LAMBDA_EXEC_ROLE_ARN=arn:aws:iam::000000000000:role/usms-lambda-exec-role
export USMS_EDGE_VIEWER_FN=usms-edge-viewer-request
export USMS_EDGE_VIEWER_FN_ARN=arn:aws:lambda:us-east-1:000000000000:function:usms-edge-viewer-request
export USMS_EDGE_VIEWER_VERSION=1
export USMS_EDGE_VIEWER_VERSION_ARN=arn:aws:lambda:us-east-1:000000000000:function:usms-edge-viewer-request:1
export USMS_EDGE_ORIGIN_FN=usms-edge-origin-response
export USMS_EDGE_ORIGIN_FN_ARN=arn:aws:lambda:us-east-1:000000000000:function:usms-edge-origin-response
export USMS_EDGE_ORIGIN_VERSION=1
export USMS_EDGE_ORIGIN_VERSION_ARN=arn:aws:lambda:us-east-1:000000000000:function:usms-edge-origin-response:1
export USMS_LAMBDA_NOTIFIER_FN=usms-transcript-notifier
export USMS_LAMBDA_NOTIFIER_FN_ARN=arn:aws:lambda:us-east-1:000000000000:function:usms-transcript-notifier
